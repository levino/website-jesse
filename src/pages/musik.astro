---
import Layout from '../layouts/Layout.astro';
import SheetMusic from '../components/SheetMusic.astro';
---

<Layout title="Musik" description="Lilypond-Dateien und Musiknoten von Jesse Keller">
  <section class="py-12 sm:py-16">
    <div class="container-narrow">
      <h1 class="text-3xl sm:text-4xl font-bold mb-4">Musik</h1>
      <p class="text-lg text-slate-600 mb-8">
        Hier findest du Musiknoten aus meinem Unterricht
        an der Freien Waldorfschule Hannover Maschsee.
      </p>

      <div class="mb-8 p-4 bg-primary-50 border border-primary-200 rounded-lg">
        <h2 class="font-semibold text-primary-900 mb-2">Was ist Lilypond?</h2>
        <p class="text-sm text-primary-800">
          <a href="https://lilypond.org" class="link" target="_blank" rel="noopener">Lilypond</a>
          ist eine freie Notensatz-Software. Die Quelldateien (.ly) sind auf GitHub verlinkt,
          damit du die Noten selbst bearbeiten kannst.
        </p>
      </div>

      <h2 class="text-2xl font-bold mb-6">Stücke</h2>

      <div class="space-y-8">
        <SheetMusic
          title="Tredeschin"
          description="Ein Singspiel — Märchen mit 21 Musikstücken für Erzähler, verschiedene Rollen und Chor."
          pdfPath="/musik/tredeschin.pdf"
          sourceUrl="https://github.com/jefroke/website/tree/main/music-sources/tredeschin"
        />

        <SheetMusic
          title="Der Winter ist ein rechter Mann"
          description="Komponist: P. Appenzeller | Text: M. Claudius — Für zwei Violinen und Gesang, 7 Strophen."
          pdfPath="/musik/der-winter-ist-ein-rechter-mann.pdf"
          sourceUrl="https://github.com/jefroke/website/blob/main/music-sources/der-winter-ist-ein-rechter-mann.ly"
        />
      </div>

      <div class="mt-12 text-center text-slate-500 text-sm">
        <p>Weitere Stücke werden nach und nach hinzugefügt.</p>
      </div>
    </div>
  </section>
</Layout>
