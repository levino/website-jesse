---
interface Props {
  title: string;
  description: string;
  pdfPath: string;
  sourceUrl: string;
}

const { title, description, pdfPath, sourceUrl } = Astro.props;
---

<div class="card">
  <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
    <div>
      <h3 class="text-lg font-semibold mb-1">{title}</h3>
      <p class="text-slate-600 text-sm">{description}</p>
    </div>
    <div class="flex gap-2">
      <a
        href={sourceUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 px-3 py-1.5 bg-slate-100 hover:bg-slate-200 rounded-lg text-sm transition-colors"
      >
        <span class="text-slate-500">🎼</span>
        Quelldatei (.ly)
      </a>
      <a
        href={pdfPath}
        download
        class="inline-flex items-center gap-2 px-3 py-1.5 bg-slate-100 hover:bg-slate-200 rounded-lg text-sm transition-colors"
      >
        <span class="text-slate-500">📄</span>
        PDF
      </a>
    </div>
  </div>
  <div class="w-full aspect-[3/4] max-h-[800px] bg-slate-100 rounded-lg overflow-hidden">
    <embed
      src={pdfPath}
      type="application/pdf"
      class="w-full h-full"
    />
  </div>
</div>
